server {
    listen 1000;
    listen [::]:1000;

    root [percorso]/meteo/web;

    # Nginx cercherà i file in questo ordine quando l'URL è una cartella (es. http://indirizzo:1001/)
    index index.php index.html index.htm;

    location / {
        # Cerca prima il file esatto, poi una cartella, e se non trova nulla passa la richiesta a index.php
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Blocco indispensabile per far elaborare i file .php a PHP-FPM
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    location ~ /\.ht {
        deny all;
    }
}
